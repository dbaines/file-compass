<Page x:Class="HDDIndexer.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Configure application preferences and behavior" FontSize="14" Opacity="0.8"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="20">
                <!-- Application Settings -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Application" FontSize="18" FontWeight="SemiBold"/>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Theme" FontWeight="SemiBold"/>
                            <ComboBox Width="200" HorizontalAlignment="Left" SelectedIndex="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}">
                                <ComboBoxItem Content="System Default"/>
                                <ComboBoxItem Content="Light"/>
                                <ComboBoxItem Content="Dark"/>
                            </ComboBox>
                        </StackPanel>

                        <ToggleSwitch Header="Auto-scan on startup" IsOn="{x:Bind ViewModel.AutoScanOnStartup, Mode=TwoWay}"/>
                        <ToggleSwitch Header="Show hidden files" IsOn="{x:Bind ViewModel.ShowHiddenFiles, Mode=TwoWay}"/>
                        <ToggleSwitch Header="Show system files" IsOn="{x:Bind ViewModel.ShowSystemFiles, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Scanning Settings -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Scanning" FontSize="18" FontWeight="SemiBold"/>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Thread Count" FontWeight="SemiBold"/>
                            <Slider Minimum="1" Maximum="8" Value="{x:Bind ViewModel.ScanThreadCount, Mode=TwoWay}" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Batch Size" FontWeight="SemiBold"/>
                            <NumberBox Value="{x:Bind ViewModel.BatchSize, Mode=TwoWay}" Width="200" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Backup Settings -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Backup" FontSize="18" FontWeight="SemiBold"/>

                        <ToggleSwitch Header="Enable automatic backups" IsOn="{x:Bind ViewModel.EnableAutoBackup, Mode=TwoWay}"/>

                        <StackPanel Spacing="10">
                            <TextBlock Text="Backup Directory" FontWeight="SemiBold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                        Text="{x:Bind ViewModel.BackupDirectory, Mode=TwoWay}"
                                        PlaceholderText="Select backup folder..."
                                        Margin="0,0,10,0"/>
                                <Button Grid.Column="1"
                                       Content="Browse"
                                       Command="{x:Bind ViewModel.SelectBackupDirectoryCommand}"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="Reset to Defaults" Command="{x:Bind ViewModel.ResetToDefaultsCommand}"/>
                    <Button Content="Save Settings" Command="{x:Bind ViewModel.SaveSettingsCommand}" Style="{StaticResource AccentButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>