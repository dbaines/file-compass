<ContentDialog x:Class="HDDIndexer.Views.AdvancedSearchDialog"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:services="using:HDDIndexer.Services"
              xmlns:models="using:HDDIndexer.Models"
              mc:Ignorable="d"
              Title="Advanced Search"
              PrimaryButtonText="Search"
              CloseButtonText="Cancel"
              IsPrimaryButtonEnabled="{x:Bind IsSearchEnabled, Mode=OneWay}">

    <ScrollViewer>
        <StackPanel Spacing="20" Width="500">
            <!-- File Name Criteria -->
            <StackPanel Spacing="10">
                <TextBlock Text="File Name" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                            Text="{x:Bind SearchCriteria.FileName, Mode=TwoWay}"
                            PlaceholderText="Enter filename pattern"
                            Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1"
                             SelectedIndex="{x:Bind SearchCriteria.MatchType, Mode=TwoWay}"
                             Width="120">
                        <ComboBoxItem Content="Contains"/>
                        <ComboBoxItem Content="Starts With"/>
                        <ComboBoxItem Content="Ends With"/>
                        <ComboBoxItem Content="Exact"/>
                        <ComboBoxItem Content="Regex"/>
                    </ComboBox>
                </Grid>
                <CheckBox Content="Case Sensitive" IsChecked="{x:Bind SearchCriteria.CaseSensitive, Mode=TwoWay}"/>
            </StackPanel>

            <!-- File Extensions -->
            <StackPanel Spacing="10">
                <TextBlock Text="File Extensions" FontWeight="SemiBold"/>
                <TextBox Text="{x:Bind ExtensionsText, Mode=TwoWay}"
                        PlaceholderText="Enter extensions separated by commas (e.g., .jpg, .png, .gif)"/>
            </StackPanel>

            <!-- File Size Range -->
            <StackPanel Spacing="10">
                <TextBlock Text="File Size Range" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <NumberBox Grid.Column="0"
                              Value="{x:Bind MinSizeMB, Mode=TwoWay}"
                              PlaceholderText="Min size"
                              Margin="0,0,5,0"/>
                    <TextBlock Grid.Column="1" Text="MB to" VerticalAlignment="Center" Margin="5"/>
                    <NumberBox Grid.Column="2"
                              Value="{x:Bind MaxSizeMB, Mode=TwoWay}"
                              PlaceholderText="Max size"
                              Margin="5,0"/>
                    <TextBlock Grid.Column="3" Text="MB" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Date Range -->
            <StackPanel Spacing="10">
                <TextBlock Text="Date Range" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DatePicker Grid.Column="0"
                               Date="{x:Bind StartDate, Mode=TwoWay}"
                               Margin="0,0,10,0"/>
                    <TextBlock Grid.Column="1" Text="to" VerticalAlignment="Center" Margin="10"/>
                    <DatePicker Grid.Column="2"
                               Date="{x:Bind EndDate, Mode=TwoWay}"
                               Margin="10,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- File Type Category -->
            <StackPanel Spacing="10">
                <TextBlock Text="File Type Category" FontWeight="SemiBold"/>
                <ComboBox SelectedIndex="{x:Bind SearchCriteria.FileType, Mode=TwoWay}" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="All Files"/>
                    <ComboBoxItem Content="Documents"/>
                    <ComboBoxItem Content="Images"/>
                    <ComboBoxItem Content="Videos"/>
                    <ComboBoxItem Content="Audio"/>
                    <ComboBoxItem Content="Archives"/>
                    <ComboBoxItem Content="Executables"/>
                    <ComboBoxItem Content="Source Code"/>
                </ComboBox>
            </StackPanel>

            <!-- Drive Selection -->
            <StackPanel Spacing="10">
                <TextBlock Text="Search in Drives" FontWeight="SemiBold"/>
                <ListView ItemsSource="{x:Bind AvailableDrives, Mode=OneWay}"
                         SelectionMode="Multiple"
                         MaxHeight="120">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Drive">
                            <CheckBox Content="{x:Bind DriveName}"
                                     IsChecked="{x:Bind IsSelected, Mode=TwoWay}"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>

            <!-- Additional Options -->
            <StackPanel Spacing="10">
                <TextBlock Text="Options" FontWeight="SemiBold"/>
                <CheckBox Content="Include subfolders" IsChecked="{x:Bind SearchCriteria.IncludeSubfolders, Mode=TwoWay}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>