<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:FileCompass.Translations;assembly=FileCompass.Translations"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="FileCompass.Desktop.Views.SettingsWindow"
        Title="{x:Static t:Strings.SettingsTitle}"
        Width="500" Height="400"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="16">
        <!-- Buttons at bottom -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{x:Static t:Strings.ButtonClose}"
                    Click="OnCloseClick"
                    Width="80"/>
        </StackPanel>

        <!-- Settings content -->
        <ScrollViewer>
            <StackPanel Spacing="16">
                <!-- Appearance Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static t:Strings.SettingsAppearance}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Static t:Strings.SettingsTheme}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      x:Name="ThemeComboBox"
                                      SelectedIndex="0"
                                      SelectionChanged="OnThemeSelectionChanged"
                                      Width="200"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="{x:Static t:Strings.SettingsThemeSystem}"/>
                                <ComboBoxItem Content="{x:Static t:Strings.SettingsThemeLight}"/>
                                <ComboBoxItem Content="{x:Static t:Strings.SettingsThemeDark}"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Search Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static t:Strings.SettingsSearch}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       Text="{x:Static t:Strings.SettingsSearchHistory}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock x:Name="HistoryCountText"
                                           Text="{x:Static t:Strings.SettingsHistoryCleared}"
                                           VerticalAlignment="Center"/>
                                <Button Content="{x:Static t:Strings.SettingsClearHistory}"
                                        Click="OnClearHistoryClick"
                                        Padding="8,4"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Database Section -->
                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Static t:Strings.SettingsDatabase}"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>

                        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Grid.Row="0"
                                       Text="{x:Static t:Strings.SettingsDatabaseLocation}"
                                       VerticalAlignment="Top"/>
                            <TextBox Grid.Column="1" Grid.Row="0"
                                     x:Name="DatabasePathText"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"/>

                            <TextBlock Grid.Column="0" Grid.Row="1"
                                       Text="{x:Static t:Strings.SettingsDatabaseSize}"
                                       VerticalAlignment="Center"
                                       Margin="0,8,0,0"/>
                            <TextBlock Grid.Column="1" Grid.Row="1"
                                       x:Name="DatabaseSizeText"
                                       VerticalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
